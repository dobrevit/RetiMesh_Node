.pio/
.vscode/
dist/
_site/
__pycache__/
*.egg-info/
build/
*.pyc

# Generated by tools/asset_stamp.py at build time
data/assets.json

# The pioarduino platform's component manager drops these into src/ on a fresh
# package install; they carry nothing of ours (dependencies: idf >= 5.1).
src/idf_component.yml
src/idf_component.yml.orig

# Signed artefacts, which are build output: a manifest and a bundle are made
# from an image that is itself not committed, and a bundle is most of two
# megabytes that git would keep for ever. Publish them on a release, not here.
*.rmfw
/*.manifest
/manifest.bin
/delegation.bin

# Private halves of the OTA signing keys, which tools/fw_sign.py writes into
# the working tree by default. A committed root key is the whole trust chain,
# and replacing one costs a visit to every deployed node. Public keys and
# delegations are published anyway, so only the secret half is refused here.
*.key
keys/

# The soak collector's working directory: its Reticulum identity, LXMF state and
# collected readings. Named here rather than only in tools/soak/.gitignore
# because that file exists only on the branch that carries the tool, and the
# directory persists in the working tree across branch switches — so a stray
# `git add -A` on any other branch commits the key the fleet is enrolled to
# trust. It has done, three times.
tools/soak/data/
tools/soak/__pycache__/
