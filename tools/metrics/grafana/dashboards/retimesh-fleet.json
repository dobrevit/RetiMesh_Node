      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "retimesh-prometheus"
          },
          "expr": "time() - (retimesh_node_last_reply_timestamp_seconds * on(node) group_left(name) retimesh_node_info{name=~\"$node\"})",
          "editorMode": "code",
          "range": true,
