            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": false,
            "lineInterpolation": "linear",
            "axisBorderShow": false,
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Signal, as the node heard us",
      "description": "A property of the path from this exporter to the node, not of the node. It moves when either end moves, and it is measured on whichever hop reached it last.",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "retimesh-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "retimesh-prometheus"
          },
          "expr": "retimesh_node_rssi_dbm * on(node) group_left(name) retimesh_node_info{name=~\"$node\"}",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "{{name}} RSSI"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": false,
            "lineInterpolation": "linear",
            "axisBorderShow": false,
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
