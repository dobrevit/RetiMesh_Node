    {
      "type": "timeseries",
      "title": "Requests that never landed",
      "description": "`no_path` means the exporter has no route and has asked for one — normal in ones and twos, a routing problem when it is every round. `delivery_failed` means the message left and was not delivered.",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "retimesh-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "retimesh-prometheus"
          },
          "expr": "sum by (node, reason) (rate(retimesh_node_request_failures_total[15m])) * on(node) group_left(name) retimesh_node_info{name=~\"$node\"}",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "{{name}} · {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
