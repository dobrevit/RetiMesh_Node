#
# Copy to .env, which git ignores, and fill in. This is where a deployment's own
# facts live: which nodes exist and how to reach them are things about your
# fleet, not about this tool, and a compose file carrying them commits them.

# The nodes to poll: LXMF delivery hashes, comma-separated. Each may carry a
# name after an "=", which becomes a label on retimesh_node_info and is what a
# dashboard legend reads. A node reports its own hash on the console — STATUS,
# the lxmf_address= line.
RETIMESH_NODES=0e202b2f65e925da0a82abda88181eb9=hilltop,5e633f2f81f367493a3339896e7cedbd=barn

# Console lines to poll as well, comma-separated. These need the exporter
# enrolled as an administrator on each node; telemetry does not. Leave empty
# for telemetry only.
#
# STACKS gives per-task stack headroom, and is the one a soak is run to
# collect. STATUS gives the restart count and reason, the previous run's fault
# counters and the heap — but a console reply over LXMF is capped at 200 bytes
# so that the whole message fits in one packet, so only its first three or so
# lines arrive and the rest is answered "(reply truncated)". Those first lines
# are the valuable ones; everything this exporter maps from STATUS after the
# heap figures will usually be absent, which is a missing series rather than a
# wrong one.
#
# Firmware that has the POWER command answers the cell and the profile there
# instead, in one short line built to travel over LXMF. Add it where the node
# has it — `HELP` on the console lists what a given build knows.
RETIMESH_COMMANDS=STACKS,STATUS

# Optional. Reticulum transports to connect straight to, host:port,
# comma-separated — for a fleet the host's own RNS instance has no route to,
# such as a bench on Wi-Fi. The port is each node's Reticulum transport, which
# is a setting on the node rather than a fixed number.
#
# In the standalone shape this compose ships, WITHOUT A PEER THE EXPORTER
# REACHES NOTHING AT ALL. The symptom is a stream of "no path yet", which reads
# like a routing problem and is in fact an empty interface list.
# RETIMESH_PEERS=10.0.0.21:4242,10.0.0.22:4242

# Where each service listens. All three run on the host's network, so these are
# host ports; loopback by default, because a Grafana bound to 0.0.0.0 is a
# Grafana on the LAN.
RETIMESH_LISTEN=127.0.0.1:9812
PROMETHEUS_LISTEN=127.0.0.1:9090
GRAFANA_ADDR=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin

# How often to ask. Seconds. Telemetry costs the node a couple of hundred bytes
# of airtime per answer and the console rather more, so these are not free: at
# SF12 a telemetry reply can be two fragments. The defaults are one round every
# five minutes and one console round every fifteen.
RETIMESH_INTERVAL=300
RETIMESH_COMMAND_INTERVAL=900
